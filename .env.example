# ==============================================================================
# ENTORNO GLOBAL & DOCKER LOCAL (COLIMA)
# ==============================================================================
NODE_ENV=development
ENVIRONMENT=local
DEBUG=1

# ==============================================================================
# BASES DE DATOS RELACIONALES (SINGLE SOURCE OF TRUTH: DJANGO ORM)
# ==============================================================================
# Configuración PostgreSQL
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_contrasena_segura_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL de conexión unificada para SQLAlchemy / Async (FastAPI)
# Formato: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB>
DATABASE_URL=postgresql+asyncpg://postgres:tu_contrasena_segura_local@localhost:5432/app_db

# Configuración MySQL (Opcional / Legacy)
MYSQL_DATABASE=app_mysql_db
MYSQL_USER=mysql_user
MYSQL_PASSWORD=tu_contrasena_mysql_local
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ==============================================================================
# REDIS & CELERY (TAREAS ASÍNCRONAS Y CACHÉ)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Configuración Broker Celery (Django)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==============================================================================
# BACKEND CORE (DJANGO REST FRAMEWORK - apps/backend-core)
# ==============================================================================
# Clave secreta de Django (generar una única en producción)
DJANGO_SECRET_KEY=django-insecure-ejemplo-local-key-cambiar-en-produccion
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Seguridad JWT
JWT_SECRET_KEY=tu_clave_secreta_jwt_compartida
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Configuración de Correo / SMTP (Desarrollo local / Mocks)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@ejemplo.com
EMAIL_HOST_PASSWORD=tu_app_password_o_token

# ==============================================================================
# BACKEND API (FASTAPI ASÍNCRONO - apps/backend-api)
# ==============================================================================
FASTAPI_PROJECT_NAME="FastAPI High-Performance Service"
FASTAPI_PORT=8000
FASTAPI_LOG_LEVEL=debug

# ==============================================================================
# FRONTEND WEB (ASTRO + REACT - apps/web)
# ==============================================================================
# NOTA: En Astro, solo las variables con prefijo PUBLIC_ se exponen al cliente.
PUBLIC_API_CORE_URL=http://localhost:8000/api/v1
PUBLIC_API_FASTAPI_URL=http://localhost:8001/api/v1
PUBLIC_SITE_URL=http://localhost:4321

# ==============================================================================
# MOBILE APP (REACT NATIVE / EXPO - apps/mobile)
# ==============================================================================
# NOTA: En Expo, solo las variables con prefijo EXPO_PUBLIC_ se exponen al cliente.
EXPO_PUBLIC_API_CORE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_API_FASTAPI_URL=http://localhost:8001/api/v1
